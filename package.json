{
  "name": "mcpqueen",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute mcpqueen --remote --file=schema.sql",
    "test": "node --test test/*.test.mjs",
    "demo:openai": "node examples/openai-responses.mjs",
    "demo:assets": "node scripts/build-demo-assets.mjs",
    "demo:assemble": "node scripts/assemble-openai-demo.mjs",
    "demo:cards": "node scripts/render-demo-cards.mjs",
    "discovery:check": "node scripts/validate-discovery.mjs",
    "examples:check": "node scripts/validate-examples.mjs",
    "distribution:check": "node scripts/validate-distribution.mjs && node scripts/validate-examples.mjs && node scripts/validate-discovery.mjs",
    "distribution:check:live": "node scripts/validate-distribution.mjs --live"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
